{
  "name": "crewroom",
  "version": "0.0.1",
  "description": "A pixel-art spaceship deck that shows your AI workers live.",
  "license": "MIT",
  "author": "B1Kjuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1Kjuu/crewroom.git"
