{
  "office": {
    "name": "Kil crew deck",
    "setting": "crew-deck"
  },
  "workers": [
    {
      "id": "developer",
      "name": "Developer",
      "sprite": "crew-1",
      "color": "#e8452c",
      "home": "console-1"
    },
    {
      "id": "designer",
      "name": "Designer",
      "sprite": "crew-2",
      "color": "#c86bd6",
      "home": "console-2"
    },
    {
      "id": "editor",
      "name": "Editor",
      "sprite": "crew-3",
      "color": "#3aa7ff",
      "home": "console-3"
    },
    {
      "id": "writer",
      "name": "Writer",
      "sprite": "crew-4",
      "color": "#5fd08a",
      "home": "console-4"
    },
    {
      "id": "researcher",
      "name": "Researcher",
      "sprite": "crew-5",
      "color": "#ffcf5c",
      "home": "console-5"
    },
    {
      "id": "operator",
      "name": "Operator",
      "sprite": "crew-6",
      "color": "#ff8a3d",
      "home": "console-6"
    },
    {
      "id": "advisor",
      "name": "Advisor",
      "sprite": "crew-7",
      "color": "#9aa4ff",
      "home": "console-7"
    },
    {
      "id": "scout",
      "name": "Scout",
      "sprite": "crew-8",
      "color": "#4fd1c5",
      "home": "console-8"
    }
  ],
  "rules": [
    {
      "worker": "advisor",
      "when": {
        "source": "log",
        "text": [
          "*brief*",
          "*health check*"
        ]
      }
    },
    {
      "worker": "scout",
      "when": {
        "source": "log",
        "text": [
          "*gmail*",
          "*scan*"
        ]
      }
    },
    {
      "worker": "editor",
      "when": {
        "skill": "b1kjuu-editor"
      }
    },
    {
      "worker": "editor",
      "when": {
        "tool": "mcp__capcut__*"
      },
      "action": "editing"
    },
    {
      "worker": "editor",
      "when": {
        "command": "ffmpeg*"
      },
      "action": "rendering"
    },
    {
      "worker": "editor",
      "when": {
        "path": "EDITS/**"
      }
    },
    {
      "worker": "writer",
      "when": {
        "skill": [
          "b1kjuu-writer",
          "avoid-ai-writing:*",
          "ig-human"
        ]
      }
    },
    {
      "worker": "designer",
      "when": {
        "skill": [
          "b1kjuu-design",
          "impeccable",
          "emil-design-eng",
          "animate"
        ]
      }
    },
    {
      "worker": "designer",
      "when": {
        "tool": "mcp__TalkToFigma__*"
      }
    },
    {
      "worker": "researcher",
      "when": {
        "skill": [
          "kil-research",
          "anthropic-skills:deep-research"
        ]
      }
    },
    {
      "worker": "operator",
      "when": {
        "tool": "mcp__whatsapp__*"
      }
    },
    {
      "worker": "developer",
      "when": {
        "skill": [
          "b1kjuu-dev",
          "superpowers:*"
        ]
      }
    },
    {
      "worker": "editor",
      "when": {
        "cwd": [
          "EDITS",
          "EDITS/**"
        ]
      }
    }
  ],
  "fallback": "developer",
  "actions": {
    "editing": {
      "label": "editing",
      "anim": "type"
    },
    "rendering": {
      "label": "rendering",
      "anim": "run"
    }
  },
  "layout": null,
  "sources": {
    "inbox": {
      "enabled": true,
      "path": null
    },
    "log": [
      {
        "path": "~/Documents/b1kjuuu-brain/log.md"
      }
    ],
    "webhook": {
      "enabled": true
    }
  }
}
